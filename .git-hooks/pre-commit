#!/bin/sh
# Pre-commit hook: lint + tests, then an advisory OpenCodeReview pass.
# Install with: git config core.hooksPath .git-hooks
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
APP_DIR="$REPO_ROOT/app"

echo "============================================="
echo "🚀 Running Pre-commit Hooks..."
echo "============================================="

# 1. Run Linter
echo "🔍 Running linter..."
npm --prefix "$APP_DIR" run lint

# 2. Run Tests with Coverage
echo "🧪 Running tests and checking coverage thresholds..."
npm --prefix "$APP_DIR" run test:coverage

echo "============================================="
echo "✅ Lint and test checks passed. Running AI review..."
echo "============================================="

# 3. Advisory AI review of the staged changes. The script always exits 0 by
#    contract; the fallback below only fires if it cannot be parsed or exec'd
#    (which the shell-checks CI gate now catches), and logs that exit so a
#    broken hook is still visible instead of silently skipped.
if [ -f "$REPO_ROOT/hooks/pre-commit-open-code-review" ]; then
  if [ -x "$REPO_ROOT/hooks/pre-commit-open-code-review" ]; then
    "$REPO_ROOT/hooks/pre-commit-open-code-review" || echo "[open-code-review] review hook exited $? (ignored)." >&2
  else
    echo "[open-code-review] hooks/pre-commit-open-code-review is not executable — skipping (run: chmod +x)." >&2
  fi
else
  echo "[open-code-review] hooks/pre-commit-open-code-review not found — skipping."
fi

echo "============================================="
echo "✅ All pre-commit checks passed successfully!"
echo "============================================="
